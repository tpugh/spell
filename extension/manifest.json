{
  "manifest_version": 3,
  "name": "Spell — spelling practice",
  "version": "0.0.1",
  "description": "Kid-friendly spelling practice with audio prompts. Word lists and test results stay on this device.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Spell",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"]
}
